rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      function signedIn() { return request.auth != null; }
      function bookPath() { return /databases/$(database)/documents/books/$(bookId); }
      function bookExists() { return exists(bookPath()); }
      function isOwner() {
        return signedIn() && bookExists() && get(bookPath()).data.owner == request.auth.uid;
      }
      // ข้อมูลที่เขียนเข้ามาต้องเป็นของคนที่ล็อกอินอยู่
      function stampedByMe() {
        return request.resource.data.uid is string && request.resource.data.uid == request.auth.uid;
      }
      function validBook() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owner', 'ownerName', 'created'])
          && d.owner is string
          && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 100))
          && (!('created' in d) || d.created is number);
      }

      // ข้อมูลสมุด: ใครก็อ่านได้ คนแรกที่ล็อกอินตั้งตัวเองเป็นเจ้าของได้ แล้วเปลี่ยนเจ้าของไม่ได้ ลบไม่ได้
      allow read: if true;
      allow create: if signedIn() && validBook() && request.resource.data.owner == request.auth.uid;
      allow update: if isOwner() && validBook() && request.resource.data.owner == resource.data.owner;
      allow delete: if false;

      // หน้าในสมุด:
      // - เจ้าของสร้าง/แก้/ลบได้ทุกหน้า
      // - เพื่อนสร้างได้ 1 หน้า (id = u_<uid>) เฉพาะสมุดที่มีเจ้าของแล้ว แก้/ลบได้เฉพาะหน้าตัวเอง และโอนหน้าให้คนอื่นไม่ได้
      match /pages/{pageId} {
        allow read: if true;
        allow create: if isOwner() ||
          (signedIn() && bookExists() && pageId == 'u_' + request.auth.uid && stampedByMe());
        allow update: if isOwner() ||
          (signedIn() && resource.data.uid == request.auth.uid && stampedByMe());
        allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      }

      // รูปและลายมือ: ใครก็ดูได้ คนที่ล็อกอินอัปโหลดของตัวเองได้เฉพาะสมุดที่มีเจ้าของแล้ว
      // ต้องเป็นรูป (data:image/...) ไม่เกิน ~1MB แก้ไม่ได้ ลบได้เฉพาะของตัวเอง (เจ้าของสมุดลบได้ทั้งหมด)
      match /assets/{assetId} {
        allow read: if true;
        allow create: if signedIn() && bookExists() && stampedByMe()
                      && assetId.matches('(img|ink)_[a-z0-9]{1,30}')
                      && request.resource.data.keys().hasOnly(['data', 'uid', 't'])
                      && request.resource.data.data is string
                      && request.resource.data.data.matches('data:image/[a-z+]+;base64,.*')
                      && request.resource.data.data.size() < 1000000;
        allow update: if false;
        allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
